{
  "recommendation": {
    "action": "{{continue_lesson | repeat_section | advance_to_next_lesson | switch_role}}",
    "target": {
      "phase_id": "{{phase_id}}",
      "lesson_id": "{{lesson_id}}"
    },
    "justification": "{{evidence-based explanation tied directly to learner_state.json, lesson assessment results, or reflection data}}",
    "evidence": [
      {
        "source": "{{learner_state | lesson_summary | evaluation}}",
        "detail": "{{specific observable data point}}"
      }
    ]
  },
  "handoff": {
    "next_role": "{{Professor | Advisor | Evaluator}}",
    "reason": "{{explicit rationale – must reference evidence}}"
  },
  "pending_updates": {
    "learner_state": {
      "lesson_id": "{{lesson_id}}",
      "status": "{{completed | in_progress | repeat}}",
      "objective_updates": [
        {
          "objective_id": "{{objective_id}}",
          "result": "{{met | partial | not_met}}",
          "notes": "{{notes}}"
        }
      ]
    }
  }
}
