{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "lesson_id",
    "module_id",
    "phase_id",
    "completed_at",
    "duration_minutes",
    "confidence_rating"
  ],
  "properties": {
    "lesson_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}-M[0-9]{2}-L[0-9]{2}$"
    },
    "title": {
      "type": "string"
    },
    "module_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}-M[0-9]{2}$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "confidence_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Numeric confidence rating (1-5 scale)"
    },
    "confidence_level": {
      "type": "string",
      "enum": ["low", "medium-low", "medium", "medium-high", "high"],
      "description": "Optional qualitative confidence descriptor"
    },
    "checkpoints_completed": {
      "type": "integer",
      "minimum": 0
    },
    "assessment_results": {
      "type": "object",
      "description": "Detailed checkpoint-by-checkpoint assessment"
    },
    "skills_developed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "key_takeaways": {
      "type": "array",
      "items": {"type": "string"}
    },
    "helm_deliverable": {
      "oneOf": [
        {"type": "string"},
        {"type": "object"}
      ],
      "description": "Helm feature or artifact produced"
    },
    "code_committed": {
      "type": "boolean"
    },
    "objectives_met": {
      "type": "array",
      "items": {"type": "string"}
    },
    "struggles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "misconceptions_noted": {
      "type": "array",
      "items": {"type": "string"}
    },
    "readiness_for_next_lesson": {
      "type": "boolean"
    },
    "professor_notes": {
      "type": "string"
    }
  }
}
